# .gitignore for Type Speed Program

# ===== BACKEND (Maven / Java) =====
backend/target/
backend/.mvn/
backend/src/main/resources/static/
*.class
*.jar
*.war
*.ear
*.log

# STS / Eclipse
backend/.sts4-cache/
backend/.project
backend/.classpath
backend/.settings/

# IntelliJ IDEA
backend/.idea/
backend/*.iml
backend/*.iws

# ===== FRONTEND (Angular / Node) =====
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Editor
.vscode/
.DS_Store
Thumbs.db
